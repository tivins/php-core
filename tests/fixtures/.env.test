# Fixture — ressemble à un .env d’application (valeurs fictives, pas de secrets réels)

APP_NAME=php-core
APP_ENV=testing
APP_DEBUG=false
APP_URL=http://localhost:8080

# Base de données (souvent une URL complète)
DATABASE_URL=postgresql://app:localdev@127.0.0.1:5432/php_core_test

# Cache
REDIS_URL=redis://127.0.0.1:6379/0

# Valeur avec un signe = dans la donnée (split limité à 2 côté chargeur)
JWT_ALG=HS256=default
